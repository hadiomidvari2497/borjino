# Borjino Environment Configuration
# Copy this file to .env and modify values as needed

# Application
APP_NAME="Borjino"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=borjino
DB_USERNAME=borjino
DB_PASSWORD=borjino_secret

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=1209600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache
CACHE_DRIVER=file
CACHE_PREFIX=borjino_

# Queue
QUEUE_CONNECTION=sync

# Mail (configure for production)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@borjino.local"
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Frontend
ASSET_URL="${APP_URL}"

# Security
BCRYPT_ROUNDS=12

# Pagination
PAGINATION_PER_PAGE=15

# File Upload
UPLOAD_MAX_SIZE=32M
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# API
API_PREFIX=api
API_VERSION=v1

# Feature Flags
FEATURE_DARK_MODE=true
FEATURE_NOTIFICATIONS=true
FEATURE_REPORTS=true